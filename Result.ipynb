import cv2  
import numpy as np  
from skimage.metrics import structural_similarity as ssim  

# Load images  
original = cv2.imread('depth_map.png', cv2.IMREAD_GRAYSCALE)  
equalized = cv2.imread('equalized_depth_map.png', cv2.IMREAD_GRAYSCALE)  
blurred = cv2.imread('blurred_depth_map.png', cv2.IMREAD_GRAYSCALE)  

# Ensure the images are loaded  
if original is None or equalized is None or blurred is None:  
    print("Error: One or more images not found.")  
    exit()  

# Function to calculate MSE  
def mse(imageA, imageB):  
    return np.mean((imageA.astype("float") - imageB.astype("float")) ** 2)  

# Function to calculate PSNR  
def psnr(imageA, imageB):  
    mse_value = mse(imageA, imageB)  
    if mse_value == 0:  
        return float('inf')  # No noise is present, perfect match  
    return 20 * np.log10(255.0 / np.sqrt(mse_value))  

# Calculate metrics  
metrics = {  
    "MSE (Equalized)": mse(original, equalized),  
    "PSNR (Equalized)": psnr(original, equalized),  
    "SSIM (Equalized)": ssim(original, equalized),  
    
    "MSE (Blurred)": mse(original, blurred),  
    "PSNR (Blurred)": psnr(original, blurred),  
    "SSIM (Blurred)": ssim(original, blurred),  
}  

# Print Results  
print("Quantitative Evaluation Results:")  
for metric, value in metrics.items():  
    print(f"{metric}: {value:.4f}")  

# Histogram Analysis  
import matplotlib.pyplot as plt  

def plot_histogram(image, title):  
    plt.figure()  
    plt.hist(image.ravel(), bins=256, range=[0, 256], color='gray', alpha=0.5)  
    plt.title(title)  
    plt.xlim([0, 255])  
    plt.xlabel('Pixel Intensity')  
    plt.ylabel('Frequency')  

# Plot histograms  
plot_histogram(original, 'Original Depth Map Histogram')  
plot_histogram(equalized, 'Equalized Depth Map Histogram')  
plot_histogram(blurred, 'Blurred Depth Map Histogram')  
plt.show()